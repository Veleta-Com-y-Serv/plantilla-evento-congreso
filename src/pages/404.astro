---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--noche relative overflow-hidden">
    <span class="hero-bloque hero-bloque--azul" aria-hidden="true"></span>
    <span class="hero-bloque hero-bloque--rosa" aria-hidden="true"></span>
    <div class="contenedor relative py-24 md:py-36">
      <p class="antetitulo">Error 404</p>
      <h1 class="hero-titulo max-w-[14ch]">Esta página no está en el programa</h1>
      <p class="hero-parrafo">Puede que el enlace esté mal o que la página se haya movido.</p>
      <div class="botones"><a class="btn mt-8" href="/">Volver al inicio</a></div>
    </div>
  </section>
</Base>
