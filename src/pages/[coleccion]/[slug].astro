---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /ponencias/<slug>/.
// Diseño «cartel de congreso»: banda cobalto con migas, título enorme y chips de día, hora y sala; a la derecha su
// foto con corte oblicuo o, sin foto, un micrófono en bloque rosa; banda crema con el `detalle` y la tabla de datos
// (borde rosa) con la caja de inscripción en noche; fotos (`imagenes`) en banda cielo y otras sesiones en banda noche
// con corte diagonal. Botones en paralelogramo y horas en monoespaciada, como en la portada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const entradas = seccion('entradas') ? enlace('/#entradas') : site.boton_cabecera?.url || enlace('/#contacto');
const textoEntradas = site.boton_cabecera?.texto || 'Reserva tu plaza';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const dato = (k: string) => f.datos.find((d) => d.clave === k)?.valor ?? '';
const dia = dato('dia');
const hora = dato('hora');
const sala = dato('sala');
const ponente = dato('ponente');
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--azul ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto suave">{f.texto}</p>}
          {(dia || hora || sala) && (
            <p class="ficha-chips">
              {(dia || hora) && <span class="ficha-hora"><Icono nombre="calendario" tam={18} /> {[dia, hora].filter(Boolean).join(' · ')}</span>}
              {sala && <span class="ficha-sala"><Icono nombre="mapa" tam={18} /> {sala}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={entradas}>{textoEntradas}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'microfono'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--crema ficha-cuerpo-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {ponente && <p class="ficha-ponente"><Icono nombre="microfono" tam={20} class="text-[var(--rosa-texto)]" /> {ponente}</p>}
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {datos.length > 0 && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">La sesión en datos</h2>
            <dl>
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda--noche">
          <p class="ficha-cita-titulo">Tu plaza, antes de que se llene</p>
          <p class="suave">Elige tu acreditación y consulta el resto del programa.</p>
          <a class="btn" href={entradas}>{textoEntradas}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--cielo" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--noche corte corte--inv ficha-otras-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras sesiones" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'microfono'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="suave">{o.texto}</p>}
              <p class="ficha-otra-pie">
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todo el programa</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3.5rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-family: var(--fuente-mono); font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--rosa); }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; text-decoration-color: var(--rosa); text-underline-offset: 4px; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto { min-width: 0; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.1rem, 5.6vw, 4.5rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: 1.75rem; }
  .ficha-hora { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--fuente-mono); font-weight: 700; color: var(--rosa); }
  .ficha-sala { display: inline-flex; align-items: center; gap: .5rem; font-weight: 650; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--noche); clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 16 / 10; background: var(--rosa); color: var(--tinta); clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; min-width: 0; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.1rem; }
  .ficha-detalle .ficha-ponente { display: flex; align-items: center; gap: .6rem; font-weight: 800; margin-bottom: 1.5rem; font-size: 1.2rem; padding-bottom: 1.25rem; border-bottom: 4px solid var(--rosa); }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; min-width: 0; }
  .ficha-lado-titulo { font-size: 1.4rem; margin-bottom: 1rem; letter-spacing: -.03em; }
  .ficha-datos { border-left: 6px solid var(--rosa); background: var(--cielo); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-family: var(--fuente-mono); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; opacity: .75; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 900; line-height: 1; letter-spacing: -.03em; }
  .ficha-cita .btn { justify-self: start; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras-banda { padding-bottom: calc(var(--corte) + 3rem); }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; border: 2px solid color-mix(in srgb, currentColor 22%, transparent); transition: border-color .2s ease; }
  .ficha-otra:hover { border-color: var(--rosa); }
  .ficha-otra-icono { display: grid; place-items: center; width: 3rem; height: 3rem; background: var(--rosa); color: var(--tinta); transform: skewX(-8deg); }
  .ficha-otra h3 { font-size: 1.3rem; margin-top: .35rem; line-height: 1.05; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--rosa); outline-offset: 3px; }
  .ficha-otra-pie { display: flex; align-items: center; margin-top: auto; padding-top: .5rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-family: var(--fuente-mono); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--rosa); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
