---
// Cifras: banda cobalto con corte diagonal arriba; `items: [{titulo = la cifra, texto}]` en cifras enormes
// separadas por una línea vertical (una de cada dos en rosa). Sin cifras no se pinta (la plataforma no las inventa).
import { seccion, cadena } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = (s?.items ?? []).filter((it) => cadena(it.titulo));
const n = Math.min(Math.max(items.length, 1), 4);
---

{
  s && items.length > 0 && (
    <Seccion id={Astro.props.id} class="banda--azul corte">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
      <ul class="cifras" style={`--n:${n}`}>
        {items.map((it) => (
          <li>
            <span class="cifra">{it.titulo}</span>
            {it.texto && <span class="mt-3 block text-lg font-semibold">{it.texto}</span>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
